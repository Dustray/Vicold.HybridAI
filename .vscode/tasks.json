{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build HybridAI Debug",
			"type": "process",
			"command": "cmake",
			"args": [
				"--build",
				"build",
				"--config",
				"Debug"
			],
			"isBackground": false,
			"problemMatcher": ["$gcc"],
			"group": "build"
		},
		{
			"label": "Build Operator Benchmark",
			"type": "process",
			"command": "cmake",
			"args": [
				"--build",
				"build-operator-benchmark",
				"--target",
				"hybridai_operator_benchmark",
				"--parallel"
			],
			"isBackground": false,
			"problemMatcher": ["$gcc"],
			"group": "build"
		}
	]
}